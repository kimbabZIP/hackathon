# 선택 사항: 값이 없으면 로컬 규칙 엔진으로 실행됩니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GRADE_GEMINI_API_KEY=
GRADE_GEMINI_MODEL=gemini-2.5-flash

# 연구실 대화 전용 설정. 비워두면 GEMINI_API_KEY/GEMINI_MODEL을 공유합니다.
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=gemini-2.5-flash

# transcript.txt가 없을 때 사용하는 실제 음성 STT·요약 설정입니다.
AUDIO_GEMINI_MODEL=gemini-2.5-flash
AUDIO_GEMINI_MAX_OUTPUT_TOKENS=65536
# 선택 사항: 시스템 PATH 또는 imageio-ffmpeg 대신 특정 FFmpeg 실행 파일을 사용할 때 지정합니다.
AUDIO_FFMPEG_PATH=
